# pixi — pixi.lock IS committed (reproducibility guarantee); only the env dir is ignored
.pixi/

# competition data is never committed (Kaggle rules) — rebuild with `pixi run data`
data/raw/*
data/external/*
!data/raw/.gitkeep
!data/external/.gitkeep

# generated submissions
submissions/*.csv

# large regenerable intermediates (eda_boot_*.parquet is ~3.5GB)
data/processed/*.parquet

# Jupyter / marimo scratch outputs
.ipynb_checkpoints/
notebooks/__marimo__/

# editor / IDE
.posit/

# Python
__pycache__/
*.egg-info/
dist/
.env
*.pyc
*.pyo
.DS_Store

# joblib cache
.cache/
